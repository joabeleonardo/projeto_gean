# Copie este arquivo para ".env" (na pasta app/) e preencha os valores.
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=nome_do_banco

# Chave usada para assinar os logins. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Senha do usuário "admin" criado automaticamente na primeira execução
ADMIN_SENHA_INICIAL=troque-esta-senha

# Opcionais
# TOKEN_EXPIRA_MINUTOS=480
# Fuso do estabelecimento (só necessário se o servidor rodar em outro fuso, ex.: nuvem em UTC)
# FUSO_HORARIO=America/Sao_Paulo
# CORS_ORIGINS=http://127.0.0.1:5500
